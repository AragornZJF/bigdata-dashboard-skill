{
  "id": "068",
  "name": "skeleton_telecom_store",
  "version": "1.0",
  "description": "电信营业厅运营效能分析大屏，含门店基本信息、历史受理趋势、营业员详情、台席健康度、耗时步骤分析、业务类型耗时分析六大模块",
  "layout": "bootstrap-grid",
  "dependencies": [
    "jquery",
    "bootstrap",
    "echarts",
    "swiper"
  ],
  "data_injection": {
    "strategy": "global_variable_override",
    "target_file": "static/js/office_efficiency_data.js",
    "variable": "data",
    "method": "Replace the entire office_efficiency_data.js content with: var data = window.DASHBOARD_DATA || {};"
  },
  "panels": [
    {
      "id": "base_info",
      "name": "门店基本信息",
      "selector": "#base-info",
      "type": "mixed",
      "components": [
        {
          "type": "text",
          "selector": ".channel-name",
          "field": "channelName"
        },
        {
          "type": "chart_pie",
          "domId": "integral_echart",
          "field": "staffHandleInfo.channelJfMap"
        },
        {
          "type": "text",
          "selector": "div[type='dingdanVal']",
          "field": "channelDeviceInfo.channelOrderNum"
        },
        {
          "type": "text",
          "selector": "div[type='custNumVal']",
          "field": "channelDeviceInfo.channelCustNum"
        },
        {
          "type": "text",
          "selector": "div[type='lineUpVal']",
          "field": "channelDeviceInfo.lineUpLatest"
        },
        {
          "type": "score_img",
          "selector": ".device-score img",
          "field": "channelDeviceInfo.finalDeviceScore"
        },
        {
          "type": "score_img",
          "selector": ".weigui img",
          "field": "staffHandleInfo.channelStartWeiGui"
        },
        {
          "type": "score_img",
          "selector": ".yingxiao img",
          "field": "staffHandleInfo.yingxiaoScore"
        },
        {
          "type": "score_img",
          "selector": ".avgtime img",
          "field": "staffHandleInfo.avgTimeScore"
        },
        {
          "type": "score_img",
          "selector": ".yewuliang img",
          "field": "staffHandleInfo.yewuliangScore"
        },
        {
          "type": "text",
          "selector": ".channel-total-score",
          "field": "staffHandleInfo.totalScore"
        }
      ]
    },
    {
      "id": "channel_handle_detail",
      "name": "门店历史受理详情",
      "selector": "#channel_handle_detail",
      "type": "chart_line_multi",
      "fields": {
        "dataDateArr": "channelHandleInfo.dataDateArr",
        "handleTimeData": "channelHandleInfo.handleTimeData",
        "lineUpData": "channelHandleInfo.lineUpData",
        "orderNumData": "channelHandleInfo.orderNumData",
        "custNumData": "channelHandleInfo.custNumData"
      }
    },
    {
      "id": "staff_info",
      "name": "营业员受理详情",
      "selector": "#staff-info",
      "type": "swiper_table",
      "fields": {
        "staffHandleInfo": "staffHandleInfo.staffHandleInfo",
        "staffWgInfo": "staffHandleInfo.staffWgInfo",
        "channelJfMap": "staffHandleInfo.channelJfMap",
        "channelStaffLen": "staffHandleInfo.channelStaffLen"
      }
    },
    {
      "id": "device_info",
      "name": "门店台席健康度",
      "selector": "#device-info",
      "type": "swiper_table",
      "fields": {
        "deviceInfo": "channelDeviceInfo.deviceInfo",
        "greenGrade": "channelDeviceInfo.greenGrade",
        "redGrade": "channelDeviceInfo.redGrade",
        "grayGrade": "channelDeviceInfo.grayGrade"
      }
    },
    {
      "id": "time_step_detail",
      "name": "耗时步骤分析",
      "selector": "#time-step-detial",
      "type": "chart_bar_grouped",
      "fields": {
        "categoryArr": "timeStepAnalysis.categoryArr",
        "channelTime": "timeStepAnalysis.channelTime",
        "provinceTime": "timeStepAnalysis.provinceTime",
        "legendArr": "timeStepAnalysis.legendArr"
      }
    },
    {
      "id": "business_type_time_detail",
      "name": "业务类型耗时分析",
      "selector": "#business-type-time-detial",
      "type": "chart_bar_line",
      "fields": {
        "categoryArr": "businessTypeAnalysis.categoryArr",
        "orderNum": "businessTypeAnalysis.orderNum",
        "avgTime": "businessTypeAnalysis.avgTime",
        "legendArr": "businessTypeAnalysis.legendArr"
      }
    }
  ],
  "charts": [
    {
      "id": "integral_echart",
      "type": "pie",
      "domSelector": "#integral_echart"
    },
    {
      "id": "channel_handle_detail",
      "type": "line_multi",
      "domSelector": "#channel_handle_detail",
      "seriesCount": 4
    },
    {
      "id": "time_step_detail",
      "type": "bar_grouped",
      "domSelector": "#time-step-detial",
      "seriesCount": 2
    },
    {
      "id": "business_type_time_detail",
      "type": "bar_line_mixed",
      "domSelector": "#business-type-time-detial",
      "seriesCount": 2
    }
  ],
  "special_notes": [
    "index.html is in page/ subdirectory, not root",
    "Data is via global 'data' variable in office_efficiency_data.js",
    "Template uses Swiper for staff/device card scrolling",
    "Has '公众'/'政企' customer type toggle (data field: custType)",
    "Star rating images (star1/star2/star3) are conditionally set based on scores",
    "Pie chart data is computed from channelJfMap (channelSum, channelOrder, channelTotal)",
    "Analysis text at top-right is computed by channelReportContent()"
  ]
}