      },
      "totalAssetsPie": {
        "id": "pie1",
        "title": "总资产",
        "type": "pie",
        "variables": [
          "option2"
        ],
        "tab": "kbbt"
      },
      "liquidAssetsPie": {
        "id": "pie2",
        "title": "可变现资产",
        "type": "pie",
        "variables": [
          "option22"
